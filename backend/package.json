{
  "name": "epsa-backend",
  "version": "1.0.0",
  "description": "HIPAA-compliant backend for ePSA - handles PHI operations",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc && cp package.json package-lock.json lib/ && ([ -f .npmrc ] && cp .npmrc lib/ || true)",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@urology-ai/epsa-engine": "^0.2.0",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "nodemailer": "^8.0.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.0",
    "@types/node-fetch": "^2.6.13",
    "typescript": "^5.3.0"
  },
  "private": true
}
