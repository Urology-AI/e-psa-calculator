rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for demo videos
    match /media1.mp4 { allow read; }
    match /media2.mp4 { allow read; }
    match /media3.mp4 { allow read; }

    // All other paths require authentication
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
