rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // ACCESS MODEL
    //
    // Clients are the patient-facing web and iOS apps, signed in anonymously
    // (or by session key). A client may only touch documents it owns.
    //
    // There is NO client-side admin tier. Staff and study-team access goes
    // exclusively through the Entra-gated epsa-admin-dashboard, whose Pages
    // Functions use a service account (Admin SDK bypasses these rules), and
    // through Cloud Functions. The former isAdmin()/isSuperAdmin() paths were
    // removed: isSuperAdmin() trusted any @mssm.edu token email, and Email/
    // Password sign-up made that trivially forgeable.
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ============================================
    // USERS — consent flags and currentSessionId, self-written by App.jsx.
    // No list, no delete.
    // ============================================
    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
    }

    match /users/{userId}/sectionLocks/{lockId} {
      allow read, write: if isOwner(userId);
    }

    // ============================================
    // SESSIONS — a visitor's own assessments.
    // ============================================
    match /sessions/{sessionId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // CLINICAL MODE SESSIONS — scoped to the device's anonymous UID.
    // ============================================
    match /clinicalSessions/{uid}/records/{recordId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // ============================================
    // APP CONFIG — world-readable flags and URLs, never secrets.
    //   appConfig/featureFlags  → published by the admin dashboard
    //   appConfig/sinai         → { redcapEnabled } for the patient flow
    //   appConfig/voiceServers  → narration voice server options
    // Written only by the admin dashboard's service account.
    // ============================================
    match /appConfig/{docId} {
      allow get: if docId in ['featureFlags', 'sinai', 'voiceServers'];
    }

    // ============================================
    // Server-only collections — Cloud Functions and the admin dashboard
    // (Admin SDK) only. Listed explicitly so their intent is documented;
    // the default deny below would refuse them anyway.
    //   analytics, admins, admin_otps, securePhoneData, auditLogs,
    //   clinicCodes, clinicCodeAuditLog, adminAccessLog, sinaiSessions
    // ============================================
    match /{collection}/{document=**} {
      allow read, write: if false;
    }
  }
}
