{
  "name": "epsa-security-rules-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Executable assertions for firestore.rules and storage.rules. Run against the Firebase emulators.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project epsa-rules-test 'vitest run'",
    "test:watch": "firebase emulators:exec --only firestore,storage --project epsa-rules-test 'vitest'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0",
    "vitest": "^2.1.8"
  }
}
