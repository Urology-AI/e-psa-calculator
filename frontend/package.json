{
  "name": "epsa-react",
  "version": "1.0.0",
  "description": "ePSA - Prostate-Specific Awareness Risk Assessment Tool",
  "private": true,
  "homepage": "https://urology-ai.github.io/e-psa-calculator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config vite.config.demo.js",
    "test": "vitest run",
    "test:patients": "node src/runPatientTests.mjs",
    "test:watch": "vitest",
    "build": "vite build",
    "build:gh-pages": "vite build --config vite.config.gh-pages.js && cd ../docs && mv index.gh-pages.html index.html && echo 'GitHub Pages build completed in ../docs directory'",
    "preview": "vite preview",
    "predeploy": "npm run build:gh-pages",
    "deploy": "gh-pages -d ../docs"
  },
  "dependencies": {
    "@epsa/engine": "npm:@urology-ai/epsa-engine@^0.2.0",
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "firebase": "^12.9.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "^5.5.207",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.1.4",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.3",
    "gh-pages": "^6.1.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
