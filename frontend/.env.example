
# Turso cloud sync for clinical staff mode (push/pull of de-identified sessions).
# Leave unset to hide the cloud sync buttons.
# NOTE: VITE_TURSO_AUTH_TOKEN is exposed to the browser (VITE_ prefix). Use a
# database-scoped read/write token with minimal permissions — never a root/org token.
VITE_TURSO_URL=libsql://your-db-name.turso.io
VITE_TURSO_AUTH_TOKEN=
